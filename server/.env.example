PORT=3000
MONGODB_URI=mongodb://localhost:27017/travellog
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=1d
# Địa chỉ client được phép gọi API (CORS), nhiều địa chỉ ngăn cách bằng dấu phẩy
CLIENT_URL=http://localhost:5173
# Địa chỉ công khai của server, dùng tạo URL ảnh khi lưu ảnh trên đĩa (không cấu hình Cloudinary)
PUBLIC_URL=http://localhost:3000
ADMIN_EMAIL=admin@travellog.local
ADMIN_PASSWORD=Admin12345
ADMIN_USERNAME=admin
# Bỏ trống thì ảnh lưu trong thư mục uploads/ (chỉ dùng khi chạy local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Bỏ trống thì ô địa điểm chỉ cho nhập tay (API trả 502)
GOOGLE_PLACES_KEY=
