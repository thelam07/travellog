# Địa chỉ API. Dev: để trống thì dùng /api (Vite proxy sang http://localhost:3000).
# Deploy Vercel: https://<ten-server>.onrender.com/api
VITE_API_URL=

# Key Google Maps JavaScript API (nền bản đồ trang cá nhân). Để trống → dùng OpenStreetMap.
# Key thật chỉ để trong client/.env và trong Environment Variables của Vercel, KHÔNG commit.
VITE_GOOGLE_MAPS_KEY=
